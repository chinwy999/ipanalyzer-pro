# Public canonical site URL used for metadata and structured data
NEXT_PUBLIC_SITE_URL=https://ip-analyzer-pro.vercel.app
NEXT_PUBLIC_SITE_NAME=IPAnalyzer Pro

# GeoIP provider: ipapi.co, ipwho.is, or ip-api.com
IP_GEO_API_PROVIDER=ipapi.co

# Optional analytics. Enable only after configuring required consent in your region.
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# Public address shown on the Contact page
NEXT_PUBLIC_CONTACT_EMAIL=contact@example.com

# Optional server-side webhook for validated contact form submissions
# When unset, the form prepares a message in the visitor's email application.
CONTACT_WEBHOOK_URL=
